{
  "name": "dsa-site",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "collect": "tsx scripts/run/collect.ts",
    "stills": "tsx scripts/run/render-stills.ts",
    "video": "tsx scripts/run/render-video.ts",
    "build": "next build",
    "serve": "tsx scripts/run/serve.ts",
    "e2e": "playwright test",
    "mutation": "stryker run",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "fumadocs-mdx && tsc --noEmit",
    "verify": "pnpm collect && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm exec playwright test && pnpm mutation"
  },
  "dependencies": {
    "@mdx-js/mdx": "3.1.1",
    "fumadocs-core": "16.19.7",
    "fumadocs-mdx": "15.6.4",
    "fumadocs-ui": "16.19.7",
    "mermaid": "12.3.0",
    "motion": "14.14.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-raw": "7.0.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@remotion/bundler": "4.0.545",
    "@remotion/cli": "4.0.545",
    "@remotion/renderer": "4.0.545",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/mdast": "4.0.4",
    "@types/mdx": "2.0.14",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "jsdom": "29.1.1",
    "mdast-util-mdx-jsx": "3.2.2",
    "postcss": "8.5.33",
    "remotion": "4.0.545",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild"
    ]
  }
}
